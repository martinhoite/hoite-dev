{
  "z-stack": {
    "base": {
      "$type": "number",
      "$value": 0,
      "$description": "Lowest stacking layer for regular page content and standard surfaces.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:3",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-base)"
        }
      }
    },
    "raised": {
      "$type": "number",
      "$value": 10,
      "$description": "Layer for elevated surfaces that sit above base content.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:4",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-raised)"
        }
      }
    },
    "dropdown": {
      "$type": "number",
      "$value": 100,
      "$description": "Layer for dropdowns to ensure they are above normal and raised content.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:5",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-dropdown)"
        }
      }
    },
    "sticky": {
      "$type": "number",
      "$value": 200,
      "$description": "Layer for sticky UI that should stay above scrolling content.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:6",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-sticky)"
        }
      }
    },
    "fixed": {
      "$type": "number",
      "$value": 300,
      "$description": "Layer for fixed UI that stays on screen.",
      "$extensions": {
        "com.figma.variableId": "VariableID:1180:138",
        "com.figma.scopes": [
          "ALL_SCOPES"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-fixed)"
        }
      }
    },
    "overlay": {
      "$type": "number",
      "$value": 400,
      "$description": "Layer for scrims and overlay surfaces above standard interactive content.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:7",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-overlay)"
        }
      }
    },
    "modal": {
      "$type": "number",
      "$value": 500,
      "$description": "Layer for modal dialogs and blocking overlays above other surfaces.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:8",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-modal)"
        }
      }
    },
    "toast": {
      "$type": "number",
      "$value": 600,
      "$description": "Layer for transient notifications shown above regular content.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:9",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-toast)"
        }
      }
    },
    "tooltip": {
      "$type": "number",
      "$value": 700,
      "$description": "Topmost layer for tooltips and short-lived teaching UI.",
      "$extensions": {
        "com.figma.variableId": "VariableID:235:10",
        "com.figma.codeSyntax": {
          "WEB": "var(--z-stack-tooltip)"
        }
      }
    }
  }
}
